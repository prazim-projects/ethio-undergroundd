{
  "name": "with-vue-nuxt",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.9.5"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "@capacitor/cli": {
      "tar": "^7.5.22"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
