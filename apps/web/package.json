{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "run-p check-types \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:native": "npm run check-types && vite build --mode native",
    "android:sync": "npm run build:native && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:package": "npm run android:sync && node ../../scripts/package_android.mjs",
    "check-types": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "test": "vitest run",
    "test:ui": "playwright test",
    "benchmark:bundle": "node ../../scripts/benchmark_bundle.mjs",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.1.5",
    "@ionic/vue": "^8.8.19",
    "ionicons": "^8.1.0",
    "lucide-vue-next": "^1.0.0",
    "ui": "*",
    "vue": "^3.4.21",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@rushstack/eslint-patch": "^1.7.2",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^20.11.24",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-config-custom": "*",
    "eslint-plugin-vue": "^9.22.0",
    "npm-run-all2": "^6.1.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "tsconfig": "*",
    "typescript": "5.5.4",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.0.4"
  }
}
